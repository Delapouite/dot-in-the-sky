# this file must be symlinked from $HOME or Emacs won't find it
# ln -s .config/XCompose .XCompose

# /usr/share/X11/locale/en_US.UTF-8/Compose
include "%L"

<Multi_key> <asterisk> <asterisk> : "⁑" U2051 # TWO ASTERISKS ALIGNED VERTICALLY
<Multi_key> <asterisk> <2> : "⁑" U2051 # TWO ASTERISKS ALIGNED VERTICALLY
<Multi_key> <asterisk> <3> : "⁂" U2042 # ASTERISM
<Multi_key> <minus> <plus> : "∓" U2213 # MINOR-OR-PLUS SIGN

# not working with explicit codepoints, must use human aliases below
# <Multi_key> <U2190> <U2190> : "⇇" U21C7 # LEFTWARDS PAIRED ARROWS
<Multi_key> <leftarrow> <leftarrow> : "⇇" U21C7 # LEFTWARDS PAIRED ARROWS
<Multi_key> <uparrow> <uparrow> : "⇈" U21C8 # UPWARDS PAIRED ARROWS
<Multi_key> <rightarrow> <rightarrow> : "⇉" U21C9 # RIGHTWARDS PAIRED ARROWS
<Multi_key> <downarrow> <downarrow> : "⇊" U21CA # DOWNWARDS PAIRED ARROWS
<Multi_key> <leftarrow> <rightarrow> : "↔" U2194 # LEFT-RIGHT ARROW
<Multi_key> <rightarrow> <leftarrow> : "↔" U2194 # LEFT-RIGHT ARROW
<Multi_key> <uparrow> <downarrow> : "↕" U2195 # UP-DOWN ARROW
<Multi_key> <downarrow> <uparrow> : "↕" U2195 # UP-DOWN ARROW

# <dead_schwa> is lafayette quote
<dead_schwa> <c> : "●" U25CF # BLACK CIRCLE
<dead_schwa> <C> : "○" U25CB # WHITE CIRCLE
<dead_schwa> <f> : "⚑" U2691 # BLACK FLAG
<dead_schwa> <F> : "⚐" U2690 # WHITE FLAG
<dead_schwa> <h> : "⧗" U29D7 # BLACK HOURGLASS
<dead_schwa> <H> : "⧖" U29D6 # WHITE HOURGLASS
<dead_schwa> <p> : "🯅" U1FBC5 # STICK FIGURE
<dead_schwa> <q> : "■" U25A0 # BLACK SQUARE
<dead_schwa> <Q> : "□" U25A1 # WHITE SQUARE
<dead_schwa> <s> : "★" U2605 # BLACK STAR
<dead_schwa> <S> : "☆" U2606 # WHITE STAR

# as <dead_schwa> to avoid overwritting existing like interrobang
<dead_schwa> <exclam> <exclam> : "‼" U203C # DOUBLE EXCLAMATION MARK
<dead_schwa> <question> <question> : "⁇" U2047 # DOUBLE QUESTION MARK
<dead_schwa> <question> <exclam> : "⁈" U2048 # QUESTION EXCLAMATION MARK
# damn emoji
<dead_schwa> <exclam> <question> : "⁉" U2049 # EXCLAMATION QUESTION MARK

